<rml>
<head>
    <title>Clear</title>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Maplestory; color: #ffffff; }
        #screen { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #010706; }
        #backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }
        #shade { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #00110c7a; }
        #title-panel { position: absolute; left: 720px; top: 124px; width: 420px; height: 150px; }
        #sign { position: absolute; left: 620px; top: 290px; width: 600px; height: 286px; opacity: 0.93; }
        #panel { position: absolute; left: 762px; top: 342px; width: 360px; height: 188px; }
        #report { position: absolute; left: 78px; top: 76px; width: 430px; height: 430px; background-color: #020b08bb; border-width: 1px; border-color: #d9ff2f; padding: 18px; }
        #tag { position: absolute; left: 82px; top: 522px; width: 335px; height: 58px; color: #d9ff2f; font-size: 26px; background-color: #03080abb; border-width: 2px; border-color: #d9ff2f; padding: 13px; }
        .eyebrow { position: absolute; left: 0px; top: 0px; width: 220px; height: 18px; font-size: 16px; color: #00eaff; }
        .title-stack { position: absolute; left: 0px; top: 26px; width: 390px; height: 64px; }
        .title-layer { position: absolute; top: 0px; font-size: 52px; }
        .title-cyan { left: -3px; color: #00eaff; }
        .title-pink { left: 3px; color: #ff2bd6; }
        .title-main { left: 0px; color: #ffffff; }
        p { position: absolute; left: 4px; top: 96px; width: 320px; height: 24px; font-size: 18px; color: #d7f2c8; }
        .button-bg { position: absolute; left: 0px; width: 320px; height: 48px; }
        button { position: absolute; left: 32px; width: 250px; height: 26px; font-size: 18px; color: #ffffff; background-color: #00000000; border-width: 0px; text-align: left; }
        button:hover { color: #d9ff2f; background-color: #00000000; border-width: 0px; }
        #bg-credits { top: 8px; }
        #btn-credits { top: 20px; }
        #bg-main-menu { top: 66px; }
        #btn-main-menu { top: 78px; }
        #bg-exit { top: 124px; }
        #btn-exit { top: 136px; }
        .report-head { display: block; font-size: 14px; color: #00eaff; margin-bottom: 8px; }
        .report-row { display: block; font-size: 15px; color: #e9ffd0; margin-bottom: 6px; }
        .report-line { display: block; width: 300px; height: 2px; background-color: #d9ff2f; margin: 8px 0 8px 0; }
        #clear-time { display: block; font-size: 17px; color: #d9ff2f; margin-bottom: 8px; }
        .score-rank { display: block; width: 410px; font-size: 12px; color: #ffffff; margin-bottom: 6px; white-space: nowrap; }
        .widget-scan-a { display: block; width: 132px; height: 2px; background-color: #00eaff; margin-bottom: 8px; }
        .widget-scan-b { display: block; width: 64px; height: 2px; background-color: #d9ff2f; margin-bottom: 12px; }
    </style>
</head>
<body>
    <div id="screen">
        <img id="backdrop" src="Images/menu_graffiti_backdrop.png" />
        <div id="shade"></div>
        <div id="report" data-ue-anchors="0 0 0 0" data-ue-offsets="78 76 430 430" data-ue-alignment="0 0">
            <div class="report-head">CLEAR DIAGNOSTIC</div>
            <div class="widget-scan-a"></div>
            <div class="report-row">Target Core: Destroyed</div>
            <div class="report-row">Combat Stream: Closed</div>
            <div class="report-row">Sync Rate: Stable</div>
            <div class="report-line"></div>
            <div id="clear-time">CLEAR TIME  --:--.--</div>
            <div id="score-rank-1" class="score-rank">#1  --:--.--</div>
            <div id="score-rank-2" class="score-rank">#2  --:--.--</div>
            <div id="score-rank-3" class="score-rank">#3  --:--.--</div>
            <div id="score-rank-4" class="score-rank">#4  --:--.--</div>
            <div id="score-rank-5" class="score-rank">#5  --:--.--</div>
            <div id="score-rank-6" class="score-rank">#6  --:--.--</div>
            <div id="score-rank-7" class="score-rank">#7  --:--.--</div>
            <div id="score-rank-8" class="score-rank">#8  --:--.--</div>
            <div id="score-rank-9" class="score-rank">#9  --:--.--</div>
            <div id="score-rank-10" class="score-rank">#10  --:--.--</div>
            <div class="widget-scan-b"></div>
        </div>
        <div id="title-panel" data-ue-anchors="1 0 1 0" data-ue-offsets="-140 124 420 150" data-ue-alignment="1 0">
            <div class="eyebrow">TARGET CUT</div>
            <div class="title-stack">
                <div class="title-layer title-cyan">Clear</div>
                <div class="title-layer title-pink">Clear</div>
                <div class="title-layer title-main">Clear</div>
            </div>
            <p>Target core collapsed.</p>
        </div>
        <img id="sign" src="Images/menu_neon_backboard.png" data-ue-anchors="1 0.5 1 0.5" data-ue-offsets="-60 73 600 286" data-ue-alignment="1 0.5" />
        <div id="tag" data-ue-anchors="0 1 0 1" data-ue-offsets="82 -140 335 58" data-ue-alignment="0 1">BOSS//DOWN</div>
        <div id="panel" data-ue-anchors="1 0.5 1 0.5" data-ue-offsets="-158 76 360 188" data-ue-alignment="1 0.5">
            <img id="bg-credits" class="button-bg" src="Images/button_credits.png" />
            <button id="btn-credits">Credits</button>
            <img id="bg-main-menu" class="button-bg" src="Images/button_main_menu.png" />
            <button id="btn-main-menu">Main Menu</button>
            <img id="bg-exit" class="button-bg" src="Images/button_exit.png" />
            <button id="btn-exit">Exit</button>
        </div>
    </div>
</body>
</rml>
