<rml>
<head>
    <title>Game Over</title>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Maplestory; color: #ffffff; }
        #screen { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #080107; }
        #backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }
        #shade { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #16040aa0; }
        #title-panel { position: absolute; left: 86px; top: 124px; width: 520px; height: 150px; }
        #sign { position: absolute; left: 60px; top: 290px; width: 600px; height: 286px; opacity: 0.93; }
        #panel { position: absolute; left: 128px; top: 342px; width: 390px; height: 188px; }
        #report { position: absolute; left: 828px; top: 134px; width: 320px; height: 260px; background-color: #07030ae0; border-width: 1px; border-color: #ff2bd6; padding: 18px; }
        .eyebrow { position: absolute; left: 0px; top: 0px; width: 220px; height: 18px; font-size: 16px; color: #00eaff; }
        .title-stack { position: absolute; left: 0px; top: 26px; width: 420px; height: 64px; }
        .title-layer { position: absolute; top: 0px; font-size: 52px; }
        .title-cyan { left: -3px; color: #00eaff; }
        .title-pink { left: 3px; color: #ff2bd6; }
        .title-main { left: 0px; color: #ffffff; }
        p { position: absolute; left: 4px; top: 96px; width: 320px; height: 24px; font-size: 18px; color: #f2c7df; }
        .button-bg { position: absolute; left: 0px; width: 320px; height: 48px; }
        button { position: absolute; left: 32px; width: 250px; height: 26px; font-size: 18px; color: #ffffff; background-color: #00000000; border-width: 0px; text-align: left; }
        button:hover { color: #d9ff2f; background-color: #00000000; border-width: 0px; }
        #bg-retry { top: 8px; }
        #btn-retry { top: 20px; }
        #bg-main-menu { top: 66px; }
        #btn-main-menu { top: 78px; }
        #bg-exit { top: 124px; }
        #btn-exit { top: 136px; }
        .report-head { display: block; font-size: 14px; color: #00eaff; margin-bottom: 12px; }
        .report-row { display: block; font-size: 17px; color: #ffd7ee; margin-bottom: 10px; }
        .report-line { display: block; width: 280px; height: 2px; background-color: #ff2bd6; margin: 13px 0 13px 0; }
        .widget-scan-a { display: block; width: 132px; height: 2px; background-color: #00eaff; margin-bottom: 8px; }
        .widget-scan-b { display: block; width: 64px; height: 2px; background-color: #ff2bd6; margin-bottom: 12px; }
        .label-name { color: #f2c7df; }
        .val-lost { color: #ff3366; font-weight: bold; }
        .val-severed { color: #ff3366; font-weight: bold; }
        .val-preserved { color: #00eaff; font-weight: bold; }
        .val-warn { color: #d7ff33; font-weight: bold; }
    </style>
</head>
<body>
    <div id="screen">
        <img id="backdrop" src="Images/menu_graffiti_backdrop.png" />
        <div id="shade"></div>
        <div id="title-panel" data-ue-anchors="0 0 0 0" data-ue-offsets="86 124 520 150" data-ue-alignment="0 0">
            <div class="eyebrow">RUN ENDED</div>
            <div class="title-stack">
                <div class="title-layer title-cyan">Game Over</div>
                <div class="title-layer title-pink">Game Over</div>
                <div class="title-layer title-main">Game Over</div>
            </div>
            <p>Vital field collapsed.</p>
        </div>
        <img id="sign" src="Images/menu_neon_backboard.png" data-ue-anchors="0 0.5 0 0.5" data-ue-offsets="60 73 600 286" data-ue-alignment="0 0.5" />
        <div id="report" data-ue-anchors="1 0 1 0" data-ue-offsets="-132 134 320 260" data-ue-alignment="1 0">
            <div class="report-head">FAILURE DIAGNOSTIC</div>
            <div class="widget-scan-a"></div>
            <div class="report-row"><span class="label-name">Vitals:</span> <span class="val-lost">Lost</span></div>
            <div class="report-row"><span class="label-name">Frame Link:</span> <span class="val-severed">Severed</span></div>
            <div class="report-row"><span class="label-name">Memory Trace:</span> <span class="val-preserved">Preserved</span></div>
            <div class="report-line"></div>
            <div class="report-row val-warn">Recovery route required.</div>
            <div class="widget-scan-b"></div>
        </div>
        <div id="panel" data-ue-anchors="0 0.5 0 0.5" data-ue-offsets="128 76 390 188" data-ue-alignment="0 0.5">
            <img id="bg-retry" class="button-bg" src="Images/button_retry.png" />
            <button id="btn-retry">Retry Boss</button>
            <img id="bg-main-menu" class="button-bg" src="Images/button_main_menu.png" />
            <button id="btn-main-menu">Main Menu</button>
            <img id="bg-exit" class="button-bg" src="Images/button_exit.png" />
            <button id="btn-exit">Exit</button>
        </div>
    </div>
</body>
</rml>
