<rml>
<head>
    <title>Credits</title>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Maplestory; color: #ffffff; }
        #screen { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #02030a; overflow: hidden; }
        #backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; opacity: 0.42; }
        #shade { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #010207d8; }
        #roll-window { position: absolute; left: 240px; top: 0px; width: 800px; height: 720px; overflow: hidden; }
        #roll-track { position: absolute; left: 0px; top: 720px; width: 800px; height: 1120px; text-align: center; }
        #fade-top { position: absolute; left: 0px; top: 0px; width: 100%; height: 150px; background-color: #02030a; opacity: 0.76; }
        #fade-bottom { position: absolute; left: 0px; bottom: 0px; width: 100%; height: 180px; background-color: #02030a; opacity: 0.84; }
        #scanline { position: absolute; left: 0px; top: 0px; width: 100%; height: 3px; background-color: #00eaff; opacity: 0.16; }
        #title-cyan { position: absolute; left: 0px; top: 0px; width: 800px; height: 56px; color: #00eaff; font-size: 44px; text-align: center; opacity: 0.42; }
        #title-pink { position: absolute; left: 0px; top: 0px; width: 800px; height: 56px; color: #ff2bd6; font-size: 44px; text-align: center; opacity: 0.42; }
        #title-main { position: absolute; left: 0px; top: 0px; width: 800px; height: 56px; color: #ffffff; font-size: 44px; text-align: center; }
        #subtitle { position: absolute; left: 0px; top: 70px; width: 800px; height: 28px; color: #d9ff2f; font-size: 20px; text-align: center; }
        #roll-line-a { position: absolute; left: 250px; top: 126px; width: 300px; height: 2px; background-color: #00eaff; opacity: 0.70; }
        #roll-line-b { position: absolute; left: 320px; top: 142px; width: 160px; height: 2px; background-color: #ff2bd6; opacity: 0.70; }
        .credit-role { position: absolute; left: 0px; width: 800px; height: 24px; color: #00eaff; font-size: 17px; text-align: center; }
        .credit-name { position: absolute; left: 0px; width: 800px; height: 46px; color: #ffffff; font-size: 32px; text-align: center; }
        .credit-note { position: absolute; left: 0px; width: 800px; height: 26px; color: #d3d8e3; font-size: 18px; text-align: center; }
        #role-01 { top: 212px; }
        #name-01 { top: 240px; }
        #role-02 { top: 346px; }
        #name-02 { top: 374px; }
        #role-03 { top: 480px; }
        #name-03 { top: 508px; }
        #role-04 { top: 614px; }
        #name-04 { top: 642px; }
        #thanks-a { top: 800px; }
        #thanks-b { top: 832px; }
        #end-title { position: absolute; left: 0px; top: 930px; width: 800px; height: 58px; color: #ffffff; font-size: 42px; text-align: center; }
        #end-sub { position: absolute; left: 0px; top: 994px; width: 800px; height: 28px; color: #d9ff2f; font-size: 18px; text-align: center; }
        #control-panel { position: absolute; left: 816px; top: 462px; width: 360px; height: 208px; opacity: 0; }
        .button-bg { position: absolute; left: 0px; width: 320px; height: 48px; }
        button { position: absolute; left: 32px; width: 250px; height: 26px; font-size: 18px; color: #ffffff; background-color: #00000000; border-width: 0px; text-align: left; }
        button:hover { color: #d9ff2f; background-color: #00000000; border-width: 0px; }
        #bg-score { top: 10px; }
        #btn-score { top: 22px; }
        #bg-main-menu { top: 68px; }
        #btn-main-menu { top: 80px; }
        #bg-exit { top: 126px; }
        #btn-exit { top: 138px; }
        #score-panel { position: absolute; left: 72px; top: 74px; width: 500px; height: 430px; background-color: #020b08dd; border-width: 1px; border-color: #d9ff2f; padding: 18px; display: none; opacity: 0; }
        #score-title { display: block; font-size: 18px; color: #00eaff; margin-bottom: 8px; }
        #score-current { display: block; font-size: 20px; color: #d9ff2f; margin-bottom: 14px; }
        .score-line { display: block; width: 320px; height: 2px; background-color: #ff2bd6; margin-bottom: 14px; }
        .score-rank { display: block; width: 480px; font-size: 13px; color: #ffffff; margin-bottom: 8px; white-space: nowrap; }
        #skip-hint { position: absolute; left: 64px; top: 626px; width: 340px; height: 24px; color: #d3d8e3; font-size: 15px; opacity: 0.68; }
    </style>
</head>
<body>
    <div id="screen" data-ue-anchors="0 0 1 1" data-ue-offsets="0 0 0 0" data-ue-alignment="0 0">
        <img id="backdrop" src="Images/menu_graffiti_backdrop.png" />
        <div id="shade"></div>
        <div id="roll-window" data-ue-anchors="0.5 0 0.5 1" data-ue-offsets="0 0 800 0" data-ue-alignment="0.5 0">
            <div id="roll-track">
                <div id="title-cyan">ENDING CREDITS</div>
                <div id="title-pink">ENDING CREDITS</div>
                <div id="title-main">ENDING CREDITS</div>
                <div id="subtitle">FINAL ARCHIVE // TARGET CORE COLLAPSED</div>
                <div id="roll-line-a"></div>
                <div id="roll-line-b"></div>

                <div id="role-01" class="credit-role">TEAM MEMBER 01</div>
                <div id="name-01" class="credit-name">김 지수</div>
                <div id="role-02" class="credit-role">TEAM MEMBER 02</div>
                <div id="name-02" class="credit-name">이 준협</div>
                <div id="role-03" class="credit-role">TEAM MEMBER 03</div>
                <div id="name-03" class="credit-name">남 윤지</div>
                <div id="role-04" class="credit-role">TEAM MEMBER 04</div>
                <div id="name-04" class="credit-name">조 상현</div>

                <div id="thanks-a" class="credit-note">SPECIAL THANKS TO THE JUNGLE WEEK 14 TEAM</div>
                <div id="thanks-b" class="credit-note">AND YOU</div>
                <div id="end-title">THE END</div>
                <div id="end-sub">THANK YOU FOR PLAYING</div>
            </div>
        </div>
        <div id="fade-top"></div>
        <div id="fade-bottom"></div>
        <div id="scanline"></div>
        <div id="control-panel" data-ue-anchors="1 1 1 1" data-ue-offsets="-104 -246 360 208" data-ue-alignment="1 1">
            <img id="bg-score" class="button-bg" src="Images/button_credits.png" />
            <button id="btn-score">Score</button>
            <img id="bg-main-menu" class="button-bg" src="Images/button_main_menu.png" />
            <button id="btn-main-menu">Main Menu</button>
            <img id="bg-exit" class="button-bg" src="Images/button_exit.png" />
            <button id="btn-exit">Exit</button>
        </div>
        <div id="score-panel" data-ue-anchors="0 0.5 0 0.5" data-ue-offsets="72 -215 500 430" data-ue-alignment="0 0.5">
            <div id="score-title">CLEAR SCOREBOARD</div>
            <div id="score-current">LAST CLEAR  --:--.--</div>
            <div class="score-line"></div>
            <div id="score-rank-1" class="score-rank">#1  --:--.--</div>
            <div id="score-rank-2" class="score-rank">#2  --:--.--</div>
            <div id="score-rank-3" class="score-rank">#3  --:--.--</div>
            <div id="score-rank-4" class="score-rank">#4  --:--.--</div>
            <div id="score-rank-5" class="score-rank">#5  --:--.--</div>
            <div id="score-rank-6" class="score-rank">#6  --:--.--</div>
            <div id="score-rank-7" class="score-rank">#7  --:--.--</div>
            <div id="score-rank-8" class="score-rank">#8  --:--.--</div>
            <div id="score-rank-9" class="score-rank">#9  --:--.--</div>
            <div id="score-rank-10" class="score-rank">#10  --:--.--</div>
        </div>
        <div id="skip-hint" data-ue-anchors="0 1 0 1" data-ue-offsets="64 -74 340 24" data-ue-alignment="0 1">Esc pauses. Buttons unlock after the staff roll.</div>
    </div>
</body>
</rml>
