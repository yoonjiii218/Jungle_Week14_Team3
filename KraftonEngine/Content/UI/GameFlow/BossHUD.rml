<rml>
<head>
    <title>Boss HUD</title>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Maplestory; color: #ffffff; pointer-events: none; }
        .panel { position: absolute; background-color: #02050bc8; border-width: 1px; border-color: #dceeff; overflow: hidden; }
        .plate { position: absolute; opacity: 0.22; }
        .label { position: absolute; font-size: 11px; color: #f4fbff; }
        .label-cyan { position: absolute; font-size: 11px; color: #00eaff; }
        .label-pink { position: absolute; font-size: 11px; color: #ff2bd6; }
        .readout { position: absolute; font-size: 10px; color: #8db6c8; }
        .line-white { position: absolute; height: 1px; background-color: #edf8ff; }
        .line-cyan { position: absolute; height: 2px; background-color: #00eaff; }
        .line-pink { position: absolute; height: 2px; background-color: #ff2bd6; }
        .line-lime { position: absolute; height: 1px; background-color: #d7ff33; }
        .scan-v { position: absolute; width: 1px; background-color: #23465a; }
        .micro { position: absolute; height: 1px; background-color: #335066; }
        .bar { position: absolute; height: 10px; background-color: #00030add; border-width: 1px; border-color: #86eaff; overflow: hidden; }
        .bar-fill { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #f7fbff; }
        .bar-fill-cyan { background-color: #00eaff; }
        .bar-fill-pink { background-color: #ff2bd6; }
        .bar-hotline { position: absolute; left: 0px; top: 2px; width: 100%; height: 1px; background-color: #ffffff; }
        .bar-tick { position: absolute; top: 0px; width: 2px; height: 10px; background-color: #02050b; }
        .chip { position: absolute; width: 34px; height: 10px; border-width: 1px; border-color: #3e7890; background-color: #07101b; }
        .chip-on { background-color: #f7fbff; border-color: #ffffff; }
        .chip-cyan { background-color: #00eaff; border-color: #00eaff; }
        .chip-pink { background-color: #ff2bd6; border-color: #ff2bd6; }

        #player-plate { left: 12px; top: 8px; width: 286px; height: 54px; }
        #player-shell { left: 14px; top: 10px; width: 274px; height: 48px; }
        #player-hp-text { left: 14px; top: 8px; width: 130px; height: 14px; color: #ffffff; }
        #player-state { left: 188px; top: 8px; width: 70px; height: 12px; }
        #player-hp-bar { left: 14px; top: 27px; width: 226px; height: 8px; }
        #player-accent-a { left: 14px; top: 40px; width: 68px; }
        #player-accent-b { left: 170px; top: 40px; width: 70px; }
        #player-chip-a { left: 244px; top: 27px; width: 8px; height: 8px; }
        #player-chip-b { left: 256px; top: 27px; width: 8px; height: 8px; }
        #player-chip-c { left: 268px; top: 27px; width: 8px; height: 8px; }

        #combo-plate { left: 24px; top: 294px; width: 196px; height: 88px; }
        #combo-shell { left: 26px; top: 296px; width: 184px; height: 78px; }
        #combo-cyan { left: 17px; top: 10px; width: 104px; height: 22px; font-size: 19px; color: #00eaff; }
        #combo-pink { left: 22px; top: 10px; width: 104px; height: 22px; font-size: 19px; color: #ff2bd6; }
        #combo-text { left: 19px; top: 10px; width: 104px; height: 22px; font-size: 19px; color: #ffffff; }
        #combo-readout { left: 124px; top: 18px; width: 42px; height: 12px; }
        #combo-bar { left: 18px; top: 45px; width: 138px; height: 8px; }
        #combo-accent { left: 18px; top: 62px; width: 54px; }
        #combo-chip-a { left: 100px; top: 62px; width: 26px; height: 8px; }
        #combo-chip-b { left: 132px; top: 62px; width: 26px; height: 8px; }

        #ultimate-plate { left: 438px; top: 638px; width: 404px; height: 66px; }
        #ultimate-shell { left: 438px; top: 638px; width: 404px; height: 58px; }
        #ultimate-text { left: 24px; top: 11px; width: 152px; height: 14px; color: #ffffff; }
        #ultimate-sub { left: 284px; top: 12px; width: 78px; height: 12px; }
        #ultimate-bar { left: 24px; top: 34px; width: 336px; height: 8px; }
        #ultimate-accent { left: 24px; top: 50px; width: 92px; }
    </style>
</head>
<body>
    <img id="player-plate" class="plate" src="Images/hud_data_plate.png" data-ue-anchors="0 0 0 0" data-ue-offsets="12 8 286 54" data-ue-alignment="0 0" />
    <div id="player-shell" class="panel" data-ue-anchors="0 0 0 0" data-ue-offsets="14 10 274 48" data-ue-alignment="0 0">
        <div id="player-hp-text" class="label">VITAL FIELD</div>
        <div id="player-state" class="readout">STRUCTURE</div>
        <div id="player-hp-bar" class="bar">
            <div id="player-hp-fill" class="bar-fill"></div>
            <div class="bar-hotline"></div>
            <div class="bar-tick" style="left: 12%;"></div><div class="bar-tick" style="left: 25%;"></div><div class="bar-tick" style="left: 37%;"></div><div class="bar-tick" style="left: 50%;"></div><div class="bar-tick" style="left: 62%;"></div><div class="bar-tick" style="left: 75%;"></div><div class="bar-tick" style="left: 87%;"></div>
        </div>
        <div id="player-accent-a" class="line-cyan"></div>
        <div id="player-accent-b" class="line-white"></div>
        <div id="player-chip-a" class="chip chip-on"></div>
        <div id="player-chip-b" class="chip chip-cyan"></div>
        <div id="player-chip-c" class="chip"></div>
    </div>

    <img id="combo-plate" class="plate" src="Images/hud_data_plate.png" data-ue-anchors="0 0.5 0 0.5" data-ue-offsets="24 -66 196 88" data-ue-alignment="0 0.5" />
    <div id="combo-shell" class="panel" data-ue-anchors="0 0.5 0 0.5" data-ue-offsets="26 -64 184 78" data-ue-alignment="0 0.5">
        <div id="combo-cyan" class="label-cyan">CHAIN</div>
        <div id="combo-pink" class="label-pink">CHAIN</div>
        <div id="combo-text" class="label">CHAIN</div>
        <div id="combo-readout" class="readout">FLOW</div>
        <div id="combo-bar" class="bar">
            <div id="combo-fill" class="bar-fill bar-fill-pink"></div>
            <div class="bar-hotline"></div>
            <div class="bar-tick" style="left: 16%;"></div><div class="bar-tick" style="left: 33%;"></div><div class="bar-tick" style="left: 50%;"></div><div class="bar-tick" style="left: 66%;"></div><div class="bar-tick" style="left: 83%;"></div>
        </div>
        <div id="combo-accent" class="line-pink"></div>
        <div id="combo-chip-a" class="chip chip-cyan"></div>
        <div id="combo-chip-b" class="chip chip-pink"></div>
    </div>

    <img id="ultimate-plate" class="plate" src="Images/hud_data_plate.png" data-ue-anchors="0.5 1 0.5 1" data-ue-offsets="0 -16 404 66" data-ue-alignment="0.5 1" />
    <div id="ultimate-shell" class="panel" data-ue-anchors="0.5 1 0.5 1" data-ue-offsets="0 -24 404 58" data-ue-alignment="0.5 1">
        <div id="ultimate-text" class="label">SIGNAL BURST</div>
        <div id="ultimate-sub" class="readout">READY SYNC</div>
        <div id="ultimate-bar" class="bar">
            <div id="ultimate-fill" class="bar-fill bar-fill-cyan"></div>
            <div class="bar-hotline"></div>
            <div class="bar-tick" style="left: 12%;"></div><div class="bar-tick" style="left: 25%;"></div><div class="bar-tick" style="left: 37%;"></div><div class="bar-tick" style="left: 50%;"></div><div class="bar-tick" style="left: 62%;"></div><div class="bar-tick" style="left: 75%;"></div><div class="bar-tick" style="left: 87%;"></div>
        </div>
        <div id="ultimate-accent" class="line-lime"></div>
        <div class="micro" style="left: 24px; top: 27px; width: 130px;"></div>
        <div class="micro" style="left: 230px; top: 27px; width: 104px;"></div>
    </div>
</body>
</rml>
